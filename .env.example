# ── COPY THIS FILE TO .env AND FILL IN YOUR VALUES ───────────────────────────
# NEVER commit .env to git!

# MongoDB (free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/aivisualworld?retryWrites=true&w=majority

# JWT Secret (generate a long random string)
JWT_SECRET=change-this-to-a-very-long-random-secret-string-minimum-32-chars

# Server
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://www.aivisualworld.com

# ── AI PROVIDER KEYS ─────────────────────────────────────────────────────────
# HuggingFace — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# Stability AI — https://platform.stability.ai
STABILITY_API_KEY=sk-...

# OpenAI (DALL-E 3) — https://platform.openai.com
OPENAI_API_KEY=sk-...

# Replicate (video generation) — https://replicate.com
REPLICATE_API_KEY=r8_...

# ── STRIPE PAYMENTS ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────────────
# Setup guide: https://console.cloud.google.com
# 1. Create a project > Enable "Google+ API" and "Google Identity"
# 2. Credentials > Create OAuth 2.0 Client ID (Web Application)
# 3. Authorized redirect URI: https://aivisualworld-api.onrender.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── MICROSOFT OAUTH ───────────────────────────────────────────────────────────
# Setup guide: https://portal.azure.com
# 1. Azure Active Directory > App registrations > New registration
# 2. Redirect URI: https://aivisualworld-api.onrender.com/api/oauth/microsoft/callback
# 3. Certificates & Secrets > New client secret
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=your-microsoft-secret

# ── API URL (used for OAuth callback construction) ────────────────────────────
API_URL=https://aivisualworld-api.onrender.com

# ── SESSION SECRET (can be same as JWT_SECRET) ────────────────────────────────
SESSION_SECRET=another-long-random-string
